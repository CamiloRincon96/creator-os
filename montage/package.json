{
  "name": "montage",
  "version": "0.1.0",
  "private": true,
  "description": "Local video and image editor to review and work with Claude",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.mjs",
