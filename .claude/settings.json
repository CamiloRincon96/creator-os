{
  "extraKnownMarketplaces": {
    "instagram-agent-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/instagram-agent-skill"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    }
  },
  "enabledPlugins": {
    "instagram-agent@instagram-agent-skill": true,
    "last30days@last30days-skill": true,
    "marketing-skills@marketingskills": true,
    "hyperframes@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" start || python \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" start || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" message || python \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" message || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" after || python \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" after || true",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" end || python \"$CLAUDE_PROJECT_DIR/production/tools/guard.py\" end || true",
            "timeout": 30,
            "statusMessage": "Checking that nothing is left pending…"
          }
        ]
      }
    ]
  }
}